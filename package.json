{
  "name": "my-finances",
  "version": "0.1.0",
  "description": "Personal portfolio tracker — Azure Functions API + Astro dashboard",
  "main": "src/functions/index.js",
  "scripts": {
    "start": "func start",
    "test": "jest",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.5.0",
    "dotenv": "^17.2.2",
    "winston": "^3.19.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.5",
    "globals": "^17.7.0",
    "jest": "^30.1.3",
    "nock": "^14.0.10",
    "prettier": "^3.9.6"
  }
}
