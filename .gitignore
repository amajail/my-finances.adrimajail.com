# Claude Code local session files. Note `.claude/*` not `.claude/` — git never
# descends into an excluded directory, so the negation below would not work.
# Project skills are the only shared config left here: settings.json and the git
# guard moved up to ~/.claude (shared via amajail/dev-kit). Anything personal or
# machine-specific (settings.local.json, worktrees/, private-symbols.txt) stays out.
.claude/*
!.claude/skills/

# Playwright MCP artifacts — screenshots/snapshots of the running dashboard
# capture REAL holdings figures (Total USD/ARS, P&L). Never commit.
.playwright-mcp/
**/.playwright-mcp/
audit-*.png
verify-*.png
*-mcp-*.png

# Environment variables (contains sensitive data)
.env
.env.local
.env.production
# Exceptions: dashboard production URL is non-sensitive and committed,
# and .env.test holds Azurite placeholder values needed for CI test runs.
!dashboard/.env.production
!.env.test

# Project status / resume notes (may contain secrets, infra names, in-flight context)
PROJECT_STATUS.md
NEXT_STEPS.md

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
error.log
combined.log
exceptions.log
rejections.log

# Temporary files
tmp/
temp/
.tmp/

# Backup files
*.bak
*.backup
*.Zone.Identifier

# Azure Functions local dev (contains secrets)
local.settings.json

# Seed data (contains real portfolio holdings — never commit)
scripts/positions.json
scripts/*.local.json
scripts/*.local.js

# Ad-hoc broker-update scripts (contain real PPCs / quantities)
scripts/update-*.js

# Reference reports — contain real broker/holdings data
portfolio-report.html
plan-rebalanceo-brokers.html

# Private strategic doc — contains real position performance figures
# (P&L percentages on real positions). Never commit.
metaprompt-rebalance-plan.md

# Machine-specific agent context, @import-ed by CLAUDE.md. Holds real Azure
# resource names and local paths — never commit.
CLAUDE.local.md

# Owner-private docs: real figures, strategy, personal plans. DEFAULT-DENY —
# everything under docs/private/ is ignored, so a new private doc is safe the
# moment it is created. Put private docs HERE, never elsewhere under docs/.
docs/private/

# Owner-private strategic framework, seeded into portfolioSettings at run time
# via `node scripts/seed-analysis-framework.js`. The example template at
# scripts/seed-analysis-framework.example.md IS committed (placeholders).
scripts/analysis-framework.local.md
