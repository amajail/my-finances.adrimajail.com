---
import '../styles/global.css';

interface Props {
  title?: string;
  active?: 'home' | 'brokers' | 'positions' | 'analysis' | 'scorecard' | 'framework' | 'settings';
}

const { title = 'Portfolio · my-finances', active = 'home' } = Astro.props;

const navItems = [
  { id: 'home',      label: 'Portfolio',  href: '/' },
  { id: 'brokers',   label: 'Brokers',    href: '/brokers' },
  { id: 'positions', label: 'Positions',  href: '/positions' },
  { id: 'analysis',  label: 'Analysis',   href: '/analysis' },
  { id: 'scorecard', label: 'Scorecard',  href: '/scorecard' },
  { id: 'instructions', label: 'Instructions', href: '/instructions' },
  { id: 'settings',  label: 'Settings',   href: '/settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 bg-[var(--color-surface)] border-b border-[var(--color-border)]">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 md:px-6 h-16">
        <a href="/" class="text-base font-bold text-[var(--color-text-primary)]">
          my-finances
        </a>
        <ul class="flex gap-1">
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class={`px-3 py-1.5 rounded-md text-sm transition-colors ${
                  active === item.id
                    ? 'bg-[var(--color-surface-2)] text-[var(--color-accent)] font-semibold'
                    : 'text-[var(--color-muted)] hover:text-[var(--color-text-primary)]'
                }`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 md:px-6 py-8">
      <slot />
    </main>
  </body>
</html>
