---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Settings · my-finances" active="settings">
  <header class="mb-6">
    <span class="eyebrow">Settings</span>
    <span class="accent-line"></span>
    <h1 class="text-2xl font-bold">Application settings</h1>
  </header>

  <div class="card p-4">
    <h2 class="font-semibold mb-4">MEP rate</h2>
    <p class="text-sm text-[var(--color-muted)] mb-3">Parallel exchange rate (MEP) for ARS/USD conversion</p>
    <form id="mep-form" class="flex gap-2 mb-3">
      <input
        name="mepRate"
        id="mep-input"
        type="number"
        step="0.01"
        placeholder="MEP rate (e.g., 850)"
        required
        class="border border-[var(--color-border)] rounded-md px-3 py-1.5 text-sm flex-1"
      />
      <button type="submit" class="row-action-btn !bg-[var(--color-accent)] !text-white !border-transparent">
        Save
      </button>
    </form>
    <div id="mep-msg" class="text-sm"></div>
  </div>

  <div class="card p-4 mt-4">
    <h3 class="font-semibold text-sm text-[var(--color-muted)]">About</h3>
    <p class="text-xs text-[var(--color-muted)] mt-2">
      More settings can be added via the API. Current settings are stored server-side and persist across sessions.
    </p>
  </div>
</Layout>

<script>
  import { api } from '../lib/api.js';

  async function loadMepRate() {
    try {
      const res = await api('/settings/mep_rate');
      document.getElementById('mep-input').value = res.value || '';
    } catch (err) {
      console.error('Failed to load MEP rate:', err);
      const msg = document.getElementById('mep-msg');
      msg.className = 'text-sm pos-negative';
      msg.textContent = err.message;
    }
  }

  document.getElementById('mep-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const value = document.getElementById('mep-input').value;
    const msg = document.getElementById('mep-msg');
    msg.className = 'text-sm';
    msg.textContent = 'Saving…';

    try {
      await api('/settings/mep_rate', {
        method: 'PUT',
        body: { value: parseFloat(value) }
      });
      msg.className = 'text-sm pos-positive';
      msg.textContent = 'Saved.';
    } catch (err) {
      msg.className = 'text-sm pos-negative';
      msg.textContent = err.message;
    }
  });

  loadMepRate();
</script>
