---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strategic Framework · my-finances" active="framework">
  <header class="mb-6">
    <span class="eyebrow">Strategic framework</span>
    <span class="accent-line"></span>
    <h1 class="text-2xl font-bold">Edit the framework used by the weekly analysis</h1>
    <p class="text-xs text-[var(--color-muted)] mt-2">
      Save to apply. The next weekly analysis run will use the saved content.
      Every save is recorded in <span class="font-medium">History</span> below — restore from there if needed.
    </p>
  </header>

  <section id="editor-card" class="card p-4 mb-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">Active framework</h2>
      <div id="active-meta" class="text-xs text-[var(--color-muted)]">Loading…</div>
    </div>

    <label class="block text-xs uppercase tracking-wider text-[var(--color-muted)] mb-1" for="content-area">Content (markdown)</label>
    <textarea
      id="content-area"
      class="w-full border border-[var(--color-border)] rounded-md px-3 py-2 text-sm font-mono"
      style="min-height: 50vh; resize: vertical;"
      spellcheck="false"
      disabled
    ></textarea>

    <div class="flex flex-wrap items-end gap-3 mt-3">
      <div class="grow">
        <label class="block text-xs uppercase tracking-wider text-[var(--color-muted)] mb-1" for="change-note">Change note (optional)</label>
        <input
          id="change-note"
          type="text"
          maxlength="280"
          placeholder="e.g. Bumped US-ETFs target to 25%"
          class="w-full border border-[var(--color-border)] rounded-md px-3 py-1.5 text-sm"
          disabled
        />
      </div>
      <div class="text-xs text-[var(--color-muted)] whitespace-nowrap">
        <span id="byte-counter">0</span> / <span id="byte-cap">61440</span> bytes
      </div>
      <button id="save-btn" class="row-action-btn" disabled>Save</button>
    </div>

    <div id="toast" class="text-xs mt-3" role="status" aria-live="polite"></div>
  </section>

  <section id="history-card" class="card p-4">
    <h2 class="font-semibold mb-3">History</h2>
    <p id="history-empty" class="text-xs text-[var(--color-muted)] hidden">
      No history yet — your first save will appear here.
    </p>
    <ul id="history-list" class="divide-y divide-[var(--color-border)] text-sm"></ul>
  </section>
</Layout>

<script>
  import { api } from '../lib/api.js';

  const $ = (id) => document.getElementById(id);

  const ui = {
    textarea: /** @type {HTMLTextAreaElement} */ ($('content-area')),
    note: /** @type {HTMLInputElement} */ ($('change-note')),
    saveBtn: /** @type {HTMLButtonElement} */ ($('save-btn')),
    byteCounter: $('byte-counter'),
    byteCap: $('byte-cap'),
    activeMeta: $('active-meta'),
    toast: $('toast'),
    historyList: $('history-list'),
    historyEmpty: $('history-empty'),
  };

  const state = {
    /** @type {string|null} */ lastSavedContent: null,
    /** @type {number} */ maxBytes: 61440,
  };

  function fmtTimestamp(iso) {
    if (!iso) return '—';
    try {
      return new Date(iso).toLocaleString();
    } catch {
      return iso;
    }
  }

  function byteLength(s) {
    return new TextEncoder().encode(s ?? '').byteLength;
  }

  function setToast(text, kind = 'info') {
    if (!text) {
      ui.toast.textContent = '';
      ui.toast.className = 'text-xs mt-3';
      return;
    }
    const color = kind === 'error' ? 'pos-negative' : kind === 'success' ? 'pos-positive' : '';
    ui.toast.className = `text-xs mt-3 ${color}`;
    ui.toast.textContent = text;
  }

  function recomputeSaveState() {
    const bytes = byteLength(ui.textarea.value);
    ui.byteCounter.textContent = bytes.toLocaleString();
    const over = bytes > state.maxBytes;
    const empty = ui.textarea.value.trim().length === 0;
    const unchanged = state.lastSavedContent !== null && ui.textarea.value === state.lastSavedContent;

    ui.byteCounter.style.color = over ? 'var(--color-negative, #c00)' : '';
    ui.saveBtn.disabled = over || empty || unchanged;
    if (over) {
      setToast(`Content exceeds maximum size (${state.maxBytes.toLocaleString()} bytes).`, 'error');
    } else if (ui.toast.textContent && ui.toast.textContent.includes('exceeds maximum size')) {
      setToast('');
    }
  }

  async function loadActive() {
    try {
      const data = await api('/framework');
      state.maxBytes = data.maxBytes || state.maxBytes;
      ui.byteCap.textContent = state.maxBytes.toLocaleString();
      ui.textarea.value = data.content || '';
      ui.textarea.disabled = false;
      ui.note.disabled = false;
      state.lastSavedContent = ui.textarea.value;
      ui.activeMeta.textContent = data.historyRowKey
        ? `Last saved: ${fmtTimestamp(data.updatedAt)}`
        : 'Last saved: (seeded — no history row)';
      recomputeSaveState();
    } catch (err) {
      if (err?.status === 404) {
        ui.activeMeta.textContent = 'Not configured';
        ui.textarea.disabled = false;
        ui.note.disabled = false;
        state.lastSavedContent = '';
        setToast('No framework configured yet. Save below to create the first version.', 'info');
        recomputeSaveState();
        return;
      }
      setToast(`Failed to load: ${err?.message || err}`, 'error');
    }
  }

  async function save() {
    ui.saveBtn.disabled = true;
    setToast('Saving…');
    try {
      const result = await api('/framework', {
        method: 'PUT',
        body: {
          content: ui.textarea.value,
          changeNote: ui.note.value.trim() || null,
        },
      });
      if (result.noop) {
        setToast('No changes to save (content matches active version).', 'info');
      } else {
        setToast(`Saved at ${fmtTimestamp(result.timestamp)}.`, 'success');
        state.lastSavedContent = ui.textarea.value;
        ui.note.value = '';
        ui.activeMeta.textContent = `Last saved: ${fmtTimestamp(result.timestamp)}`;
        // History will load in US2 (Phase 4).
      }
    } catch (err) {
      setToast(`Save failed: ${err?.message || err}`, 'error');
    } finally {
      recomputeSaveState();
    }
  }

  ui.textarea.addEventListener('input', recomputeSaveState);
  ui.saveBtn.addEventListener('click', save);

  // History list — placeholder (US2 fleshes this out). For now show empty state.
  ui.historyEmpty.classList.remove('hidden');

  loadActive();
</script>
