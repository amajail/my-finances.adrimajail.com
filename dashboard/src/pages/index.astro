---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio · my-finances" active="home">
  <header class="mb-8">
    <span class="eyebrow">Consolidated Portfolio</span>
    <span class="accent-line"></span>
    <div>
      <h1 class="text-3xl font-bold tracking-tight" id="grand-total">—</h1>
      <p class="text-sm text-[var(--color-muted)]">
        Last refresh: <span id="last-refresh">—</span>
      </p>
    </div>
  </header>

  <section id="stat-row" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8"></section>

  <section id="brokers-section" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10"></section>

  <section id="positions-by-broker" class="space-y-6 mb-10"></section>

  <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div id="top-performers"></div>
    <div id="bottom-performers"></div>
  </section>
</Layout>

<script>
  import { initPortfolioPage } from '../lib/portfolio-page.js';
  initPortfolioPage();
</script>
